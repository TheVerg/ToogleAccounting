APP_NAME="Holdco Accounting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://accounting.example.com
APP_TIMEZONE=Africa/Harare

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
ADMIN_INITIAL_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=holdco
DB_USERNAME=holdco
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=accounting@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Only Nginx can reach PHP-FPM in the private Docker network. It overwrites
# forwarded client headers before passing the request to Laravel.
TRUSTED_PROXIES=*

# Host port consumed by your TLS reverse proxy (Caddy, Nginx, or a load balancer).
HTTP_PORT=8080
HTTP_BIND_ADDRESS=127.0.0.1
